<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin{% endblock %}</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body { background-color: #f4f6f9; }
        .card-hover:hover { transform: scale(1.02); transition: 0.2s; }
    </style>
</head>

<body>
<nav class="navbar navbar-dark bg-dark px-4">
    <span class="navbar-brand">🍽️ YummiApp Admin</span>
    <span class="text-white">{{ app.user ? app.user.email : '' }}</span>
</nav>

<div class="container my-5">
    {% block body %}{% endblock %}
</div>

</body>
</html>
