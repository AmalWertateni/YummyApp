{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - YummiApp{% endblock %}

{% block body %}
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-white py-4 border-0">
                        <div class="text-center">
                            <i class="fas fa-key fa-3x text-primary mb-3"></i>
                            <h2 class="h4 font-weight-bold">Réinitialiser le mot de passe</h2>
                            <p class="text-muted">Entrez votre email pour recevoir un lien de réinitialisation</p>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <form action="{{ path('app_forgot_password_request') }}" method="post">
                            <div class="form-group mb-4">
                                <label for="email" class="form-label">Adresse email</label>
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                    <span class="input-group-text">
                                        <i class="fas fa-envelope"></i>
                                    </span>
                                    </div>
                                    <input type="email"
                                           id="email"
                                           name="email"
                                           class="form-control"
                                           placeholder="votre@email.com"
                                           required>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="fas fa-paper-plane mr-2"></i>Envoyer le lien
                                </button>
                                <a href="{{ path('app_login') }}" class="btn btn-link">
                                    <i class="fas fa-arrow-left mr-1"></i>Retour à la connexion
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
